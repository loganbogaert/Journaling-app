# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_journal
DB_NAME_TEST=trading_journal_test
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_DIALECT=postgres

# Auth — tokens are issued by Keycloak; the backend verifies them via Keycloak's JWKS endpoint.
# KEYCLOAK_URL is the internal (container-to-container) address; KEYCLOAK_ISSUER_URL is the
# public address (through Kong) that Keycloak stamps into the token's `iss` claim.
KEYCLOAK_URL=http://keycloak:8080/auth
KEYCLOAK_ISSUER_URL=http://localhost:8000/auth
KEYCLOAK_REALM=trading-journal

# Gateway — shared secret Kong injects on every request it forwards; requests without a
# matching header are rejected so the API is never reachable while bypassing Kong
# generate with: openssl rand -base64 32
KONG_GATEWAY_SECRET=replace-with-a-random-32-char-secret
