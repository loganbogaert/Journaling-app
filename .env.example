# Database
DB_NAME=trading_journal
DB_USER=postgres
DB_PASSWORD=changeme

# Auth — Keycloak issues/validates user tokens; Kong is the only client allowed to
# reach the backend directly (enforced via KONG_GATEWAY_SECRET)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
KEYCLOAK_DB_PASSWORD=changeme

# generate with: openssl rand -base64 32
KONG_GATEWAY_SECRET=replace-with-a-random-32-char-secret
TRADE_API_CLIENT_SECRET=generate-a-random-client-secret
BROKER_INTEGRATION_CLIENT_SECRET=generate-a-random-client-secret

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_BUCKET=trading-images

META_API_ACCESS_TOKEN=replace-with-your-metaapi-access-token
META_API_REGION=london
# Generate once with openssl rand -hex 32; back up this key to retain access to encrypted credentials.
CREDENTIALS_ENCRYPTION_KEY=replace-with-a-64-character-random-hex-key
