# Database
DB_NAME=trading_journal
DB_USER=postgres
DB_PASSWORD=changeme

# Auth — Keycloak issues/validates user tokens; Kong is the only client allowed to
# reach the backend directly (enforced via KONG_GATEWAY_SECRET)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
KEYCLOAK_DB_PASSWORD=changeme

# generate with: openssl rand -base64 32
KONG_GATEWAY_SECRET=replace-with-a-random-32-char-secret
# Docker Desktop local default; increase for higher-throughput deployments.
KONG_NGINX_WORKER_PROCESSES=1

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_BUCKET=trading-images
