/dist
/tmp
/out-tsc
/bazel-out

# IDEs and editors
.project
.classpath
.c9/
*.launch
.settings/

# Visual Studio Code
.vscode/
.history/*

# Miscellaneous
/.angular/cache
.sass-cache/
/connect.lock
/coverage
/typings
